# Discord Bot Token (Lấy từ Discord Developer Portal: https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Client ID của Bot (Application ID)
CLIENT_ID=your_client_id_here

# Prefix cho các lệnh thường (Mặc định là !)
PREFIX=!

# Discord ID của Admin Thiên Đạo (có thể cách nhau bằng dấu phẩy nếu có nhiều admin)
ADMIN_ID=905657612928958484

# Kết nối MongoDB (Hỗ trợ MongoDB Atlas Cloud hoặc MongoDB Local)
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tutien_bot?retryWrites=true&w=majority
# Ví dụ Local: mongodb://127.0.0.1:27017/tutien_bot
MONGODB_URI=mongodb://127.0.0.1:27017/tutien_bot

# Cấu hình cho Tool AI Live Farmer (AI tự đăng nhập vào kênh Discord chơi thật)
# AI_TARGET_CHANNEL_ID: ID của kênh chat trong Discord server bạn muốn AI vào gửi lệnh
AI_TARGET_CHANNEL_ID=your_channel_id_here
# AI_DISCORD_TOKEN: Token của tài khoản AI (hoặc để trống sẽ tự dùng DISCORD_TOKEN)
AI_DISCORD_TOKEN=your_ai_token_here

# Google Gemini API Key (Miễn phí từ Google AI Studio: https://aistudio.google.com/app/apikey)
# Dùng để kích hoạt Bộ Não Trí Tuệ Nhân Tạo LLM tự đọc hiểu, suy luận và ghi nhớ trick game
GEMINI_API_KEY=your_gemini_api_key_here
