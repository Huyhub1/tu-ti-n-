# ============================================================
#  TU TIÊN DISCORD BOT — MẪU CẤU HÌNH
#  Sao chép file này thành .env rồi điền giá trị thật.
#  TUYỆT ĐỐI KHÔNG commit file .env lên git.
# ============================================================

# Discord Bot Token (Discord Developer Portal: https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Client ID của Bot (Application ID)
CLIENT_ID=your_client_id_here

# Prefix cho các lệnh thường (Mặc định là !)
PREFIX=!

# Discord ID của Admin Thiên Đạo — BẮT BUỘC, nhiều admin thì cách nhau bằng dấu phẩy.
# Để trống = toàn bộ lệnh !admin bị khóa (đây là mặc định an toàn).
# Lấy ID: bật Developer Mode trong Discord > chuột phải vào tên mình > Copy User ID.
ADMIN_ID=

# Kết nối MongoDB — BẮT BUỘC, thiếu là bot dừng ngay khi khởi động.
# Ví dụ Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tutien_bot?retryWrites=true&w=majority
# Ví dụ Local: mongodb://127.0.0.1:27017/tutien_bot
MONGODB_URI=mongodb://127.0.0.1:27017/tutien_bot

# ============================================================
#  TỰ CẬP NHẬT TỪ GIT
#  Đẩy commit lên kho là mọi máy đang chạy bot tự kéo về và tự bật lại.
#  Chỉ có tác dụng khi khởi động bằng "npm start" (qua tiến trình giám sát).
# ============================================================

# Bật/tắt vòng tự dò bản mới. Để trống hoặc false = tắt.
AUTO_UPDATE=false

# Bao lâu soát kho một lần (phút). Kẹp trong khoảng 1–1440, mặc định 5.
AUTO_UPDATE_INTERVAL_MINUTES=5

# Tên remote và nhánh cần theo. Để trống nhánh = dùng đúng nhánh đang đứng.
AUTO_UPDATE_REMOTE=origin
AUTO_UPDATE_BRANCH=

# Kênh Discord để báo "đang bế quan cập nhật". Để trống = không báo, chỉ ghi log.
AUTO_UPDATE_CHANNEL_ID=

# Sau khi kéo về có chạy "npm run audit" để nghiệm thu bản mới không.
# Để nguyên (bật). Tắt đi nghĩa là một commit hỏng cũng được cho chạy thẳng.
AUTO_UPDATE_VERIFY=true
